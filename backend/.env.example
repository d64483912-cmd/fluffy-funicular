# Nelson-GPT RAG Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS allowed origins (comma separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from your Supabase project settings
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Embedding model settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Mistral AI Configuration
# =============================================================================
# Get from https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key

# Model settings
CHAT_MODEL=mistral-large
MISTRAL_TEMPERATURE=0.3
MISTRAL_TOP_P=0.95
MISTRAL_MAX_TOKENS=4096

# =============================================================================
# RAG Configuration
# =============================================================================
# Number of results to retrieve
TOP_K_RESULTS=5

# Maximum context tokens for prompt
MAX_CONTEXT_TOKENS=4000

# Chunk overlap for context
CHUNK_OVERLAP=200

# Vector search settings
VECTOR_SEARCH_METRIC=cosine
VECTOR_SEARCH_PROBES=10

# =============================================================================
# Performance and Rate Limiting
# =============================================================================
# Number of concurrent requests (be mindful of rate limits)
CONCURRENT_REQUESTS=3

# Rate limit per minute per user
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Cache settings
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Data Directory
# =============================================================================
DATA_DIR=./data

# =============================================================================
# Optional: Monitoring and Analytics
# =============================================================================
# Set to true to enable detailed telemetry
ENABLE_TELEMETRY=false